[Unit]
Description=ObserveX Managed node (Node Supervisor)
Documentation=https://github.com/ObservexINC/Observex_managed/blob/main/packaging/linux/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=observex
Group=observex
Environment=OBSERVEX_NODE_CONFIG=/etc/observex/node.json
ExecStart=/opt/observex/bin/observex-node run
# systemd restarts the Node Supervisor if it dies; the supervisor restarts
# the components.
Restart=on-failure
RestartSec=5s
# SIGTERM goes to the supervisor, which stops the components in reverse
# order (NGINX finishes open requests). Anything left after the timeout is
# killed.
KillMode=mixed
TimeoutStopSec=90s

# /run/observex (generated NGINX configuration) and /var/lib/observex.
RuntimeDirectory=observex
RuntimeDirectoryMode=0750
StateDirectory=observex
StateDirectoryMode=0750
UMask=0027

# The Front Door binds ports 443 and 9443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Hardening. The node reads /etc/observex and writes only its own state and
# runtime directories.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
